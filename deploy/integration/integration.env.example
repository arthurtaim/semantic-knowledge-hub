# Test-environment integration settings (TEST GitLab + TEST Confluence MCP + TEST Confluence DC REST). NO SECRETS IN THIS FILE.
# 1) cp deploy/integration/integration.env.example deploy/integration/integration.env   (git-ignored)
# 2) put secrets as files in a directory OUTSIDE the repository, e.g. ~/.config/skh-secrets:
#      gitlab_token, confluence_mcp_token, (stage A2+) confluence_rest_token, (optional) corporate-ca.pem
#    chmod 600 the files; the container runs as uid 10001 — make them readable for it (e.g. chmod 644 on a
#    private host, or chown 10001) — and export SKH_SECRETS_DIR=<that directory>.
# 3) make preflight-integration   → offline check, no connections
# 4) make integration-up          → starts the stack with egress for the backend (only when approved)
#
# Phase 1 is READ-ONLY: keep GITLAB_PROPOSALS_ENABLED=false and CONFLUENCE_PUBLISH_ENABLED=false.
# Runbook: docs/STAGING_TEST_RUNBOOK.md; parameters: docs/M4_M5_INTEGRATION_READINESS.md.

APP_ENV=local
AUTH_MODE=local_demo
LOG_LEVEL=INFO
# Run mode: live_read_only = real TEST systems over https, no writes at all (GitLab MR and Confluence writes refused).
# live_write_staging only after separate written approval (docs/STAGING_TEST_RUNBOOK.md, stages B and C).
INTEGRATION_PROFILE=live_read_only

# --- Knowledge: TEST GitLab project (read-only in phase 1) ---------------------------------------
KNOWLEDGE_BACKEND=gitlab
# https://<test-gitlab-host>  (no path, no credentials)
GITLAB_URL=
# numeric ID or URL-encoded full path, e.g. 1234 or group%2Fknowledge-test
GITLAB_PROJECT_ID=
GITLAB_DEFAULT_BRANCH=main
# sub-directory with knowledge documents inside the repository (empty = repository root)
GITLAB_KNOWLEDGE_PATH=
GITLAB_TOKEN_FILE=/run/skh-secrets/gitlab_token
# uncomment when the GitLab certificate is issued by a corporate CA
# GITLAB_CA_BUNDLE=/run/skh-secrets/corporate-ca.pem
GITLAB_TIMEOUT_SECONDS=15
GITLAB_REFRESH_SECONDS=60
GITLAB_PROPOSALS_ENABLED=false
# Proposal link in MR descriptions (loopback only while AUTH_MODE=local_demo), e.g. http://127.0.0.1:5173
APP_PUBLIC_URL=

# --- Corporate knowledge: TEST Confluence Data Center via the approved MCP server ------------------
CONFLUENCE_CONNECTOR=mcp
# https://<mcp-host>/<path>  (Streamable HTTP endpoint)
CONFLUENCE_MCP_URL=
CONFLUENCE_MCP_AUTH_TOKEN_FILE=/run/skh-secrets/confluence_mcp_token
# service_account = one shared token: per-user Confluence ACLs are NOT enforced (single-user test only)
CONFLUENCE_MCP_AUTH_MODEL=service_account
# CONFLUENCE_MCP_CA_BUNDLE=/run/skh-secrets/corporate-ca.pem
# Seconds a successful tools/list discovery and the MCP status are reused (0 = re-check every time).
CONFLUENCE_MCP_STATUS_TTL_SECONDS=60
# Only these spaces are queried and shown (comma-separated keys of the TEST space(s)).
CONFLUENCE_ALLOWLISTED_SPACES=
# Hosts allowed in page links, and the base for relative links (_links.webui).
CONFLUENCE_LINK_HOSTS=
CONFLUENCE_WEB_BASE_URL=
# Fill in after reading tools/list of the test server (names are never guessed), e.g.
# {"search":{"tool":"<name>","query_arg":"<arg>","limit_arg":"<arg>","spaces_arg":"<arg>"},"read":{"tool":"<name>","id_arg":"<arg>"}}
CONFLUENCE_MCP_TOOL_MAP=
# Optional: where page fields are in tool results, e.g. {"items":"results","id":"content.id","space":"content.space.key"}
CONFLUENCE_MCP_RESULT_MAP=

# --- Publication: TEST Confluence Data Center via REST (separate from MCP; stage A2 = dry-run only) ------
# Empty CONFLUENCE_REST_URL = publication disabled. With a URL and CONFLUENCE_PUBLISH_ENABLED=false only
# publication jobs and dry-run (GET requests) are possible.
# https://<confluence-host>/<context-path>   (fill locally, never commit)
CONFLUENCE_REST_URL=
# Dedicated publishing PAT as a file — NOT the MCP token. Set when CONFLUENCE_REST_URL is set, e.g.
# CONFLUENCE_REST_TOKEN_FILE=/run/skh-secrets/confluence_rest_token
CONFLUENCE_REST_TOKEN_FILE=
# Required for writes in live_write_staging:
# CONFLUENCE_REST_CA_BUNDLE=/run/skh-secrets/corporate-ca.pem
CONFLUENCE_REST_TIMEOUT_SECONDS=15
# Key of the [TEST] space and numeric ID of the parent page (the only publication target).
CONFLUENCE_TARGET_SPACE=
CONFLUENCE_PARENT_PAGE_ID=
CONFLUENCE_PUBLISH_STATUSES=approved
# Writes stay OFF. Only for stage C (live_write_staging, written approval): CONFLUENCE_PUBLISH_ENABLED=true and
# CONFLUENCE_PUBLISH_STAGING_ACK=<same key as CONFLUENCE_TARGET_SPACE>.
CONFLUENCE_PUBLISH_ENABLED=false
CONFLUENCE_PUBLISH_STAGING_ACK=

# --- AI stays offline unless an internal model is approved separately ----------------------------
AI_PROVIDER=mock
# AI_PROVIDER=internal_api
# AI_BASE_URL=
# AI_MODEL=
# AI_ALLOWED_HOSTS=
# AI_API_KEY_FILE=/run/skh-secrets/ai_api_key
# AI_CA_BUNDLE=/run/skh-secrets/corporate-ca.pem
