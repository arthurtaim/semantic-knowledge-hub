# Personal test stack with the Claude Code CLI provider. Copy to deploy/claude-test/claude-test.env (git-ignored).
# No secrets here: the OAuth token lives in $SKH_CLAUDE_SECRETS_DIR/claude_code_oauth_token (mode 600).

# UI port on 127.0.0.1 of the server (reach it with: ssh -N -L 5180:127.0.0.1:5180 root@<host>)
FRONTEND_PORT=5180
BIND_ADDRESS=127.0.0.1

# Directory OUTSIDE the repository with the file claude_code_oauth_token (created with `claude setup-token`)
SKH_CLAUDE_SECRETS_DIR=/opt/semantic-kb-claude-test/secrets

# claude_cli (default) | mock — switch back to the demo provider without touching the code
SKH_AI_PROVIDER=claude_cli

# Optional: model alias for the CLI (empty = the subscription default), timeouts, concurrency
CLAUDE_CLI_MODEL=
CLAUDE_CLI_TIMEOUT_SECONDS=120
CLAUDE_CLI_DRAFT_TIMEOUT_SECONDS=240
CLAUDE_WORKER_MAX_CONCURRENCY=1

# Synthetic corporate pages for the "Корпоративные" scope (mock) or disabled
CONFLUENCE_CONNECTOR=mock

# Public link (opt-in): a Caddy gateway on ports 80/443 in front of the UI. Open by default (Caddyfile);
# Caddyfile.login adds a login generated by deploy.sh (plain text in /opt/semantic-kb-claude-test/public-access.txt).
# The app itself stays on loopback.
SKH_PUBLIC_ACCESS=false
SKH_PUBLIC_CADDYFILE=Caddyfile
SKH_PUBLIC_IP=203.0.113.10
SKH_PUBLIC_HOST=203-0-113-10.sslip.io
SKH_PUBLIC_AUTH_DIR=/opt/semantic-kb-claude-test/public-auth
# M6 tasks behind the public link are read-only. true = the ONE shared login of Caddyfile.login may change tasks
# (everyone behind it is one user; the open Caddyfile link stays read-only). Owner decision for the demo stand.
WORK_SHARED_LOGIN_WRITES=false
