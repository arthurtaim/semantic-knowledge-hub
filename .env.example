# Default: entirely offline local demo; do not place live credentials here.
# For the TEST integration environment use deploy/integration/integration.env.example instead.
# Copy to .env only if you need to change something; every value below is the safe default.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173
AUTH_MODE=local_demo
# Host headers accepted by the API. local_demo accepts loopback names only (fails closed otherwise).
ALLOWED_HOSTS=localhost,127.0.0.1,::1
LOG_LEVEL=INFO

# Run mode (docs/M4_M5_INTEGRATION_READINESS.md): offline | integration_mock | live_read_only | live_write_staging.
# offline = no integrations at all (any GitLab/MCP/internal AI/Confluence REST setting refuses to start).
INTEGRATION_PROFILE=offline
# integration_mock only: hosts of local TEST DOUBLES (loopback, *.example, *.test, *.invalid, *.localhost or <name>-mock).
MOCK_SERVICE_HOSTS=

# Content — a separate GitLab repository when available.
KNOWLEDGE_BACKEND=local
LOCAL_KNOWLEDGE_DIR=./workspace/knowledge
FIXTURES_DIR=./fixtures/knowledge
SEED_FIXTURES=true
LOCAL_CONTENT_IS_DEMO=true
REVIEW_STALE_DAYS=180
# Directory with document templates (*.md); empty = built-in backend/app/document_templates.
DOCUMENT_TEMPLATES_DIR=
GITLAB_URL=
GITLAB_PROJECT_ID=
GITLAB_DEFAULT_BRANCH=main
# Optional sub-directory with knowledge documents inside the GitLab repository.
GITLAB_KNOWLEDGE_PATH=
GITLAB_TIMEOUT_SECONDS=15
GITLAB_REFRESH_SECONDS=60
# Configure via approved secret storage / environment injection, never commit secrets:
GITLAB_TOKEN=
# Preferred: path to a file with the token (Docker/K8s secret, vault agent); mutually exclusive with GITLAB_TOKEN.
GITLAB_TOKEN_FILE=
# PEM bundle of the corporate CA (empty = system trust store).
GITLAB_CA_BUNDLE=

# Search and derived local state (rebuildable; never authoritative knowledge).
SEARCH_BACKEND=sqlite_fts
SEARCH_INDEX_PATH=./workspace/search.sqlite3
APP_STATE_PATH=./workspace/app_state.sqlite3
# Publication jobs, document -> Confluence page mappings and events (back it up: docs/CONFLUENCE_SYNC_RUNBOOK.md).
PUBLICATION_STATE_PATH=./workspace/publications.sqlite3

# AI — safe no-network default. Never implicitly use public endpoints.
# AI_PROVIDER: mock | internal_api | claude_cli | disabled
#   claude_cli = EXPERIMENTAL personal test with the owner's Claude subscription through the isolated Claude Code
#   CLI worker (docs/CLAUDE_CODE_CLI_INTEGRATION.md); needs CLAUDE_CLI_PERSONAL_USE_ACK=true, a non-offline
#   INTEGRATION_PROFILE and CLAUDE_CLI_WORKER_URL. Synthetic data only, one operator.
AI_PROVIDER=mock
CLAUDE_CLI_WORKER_URL=
CLAUDE_CLI_PERSONAL_USE_ACK=false
CLAUDE_CLI_TIMEOUT_SECONDS=120
CLAUDE_CLI_DRAFT_TIMEOUT_SECONDS=240
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_API_KEY_FILE=
AI_CA_BUNDLE=
# Comma-separated hostnames the backend may call for AI (must contain the AI_BASE_URL host).
AI_ALLOWED_HOSTS=
AI_TIMEOUT_SECONDS=30
# Assistant attachments (UI v2): hours the extracted text of a file attached to a conversation is kept (1–168).
ATTACHMENTS_TTL_HOURS=24

# Confluence Data Center via approved read-only MCP (disabled by default).
# CONFLUENCE_CONNECTOR: disabled | mock (synthetic pages, for demos/tests) | mcp
CONFLUENCE_CONNECTOR=disabled
CONFLUENCE_MCP_URL=
CONFLUENCE_MCP_AUTH_TOKEN=
CONFLUENCE_MCP_AUTH_TOKEN_FILE=
CONFLUENCE_MCP_CA_BUNDLE=
CONFLUENCE_ALLOWLISTED_SPACES=
# JSON mapping of capabilities to tools discovered on the approved MCP server (tool names are never guessed):
# {"search":{"tool":"<name>","query_arg":"query","limit_arg":"limit","spaces_arg":"spaces"},"read":{"tool":"<name>","id_arg":"page_id"}}
CONFLUENCE_MCP_TOOL_MAP=
# Hosts allowed in links returned by Confluence (anything else is shown as a non-clickable reference).
CONFLUENCE_LINK_HOSTS=
# Base for relative links such as _links.webui (host must be in CONFLUENCE_LINK_HOSTS).
CONFLUENCE_WEB_BASE_URL=
# Optional JSON: where page fields are in tool results, e.g. {"items":"results","id":"content.id"}
CONFLUENCE_MCP_RESULT_MAP=
# Seconds a successful tools/list discovery and the MCP status are reused (0 = re-check every time).
CONFLUENCE_MCP_STATUS_TTL_SECONDS=60

# Confluence Data Center REST publisher (M5) — separate from the read-only MCP connector.
# Empty CONFLUENCE_REST_URL = publication disabled. URL set + writes off = publication jobs and dry-run (reads only).
# Writes stay OFF: CONFLUENCE_PUBLISH_ENABLED=true is accepted only with INTEGRATION_PROFILE=integration_mock (declared
# test double) or live_write_staging (with CONFLUENCE_PUBLISH_STAGING_ACK and CONFLUENCE_REST_CA_BUNDLE).
CONFLUENCE_PUBLISH_ENABLED=false
# Base URL including the context path; https only (http only for a declared test double).
CONFLUENCE_REST_URL=
# Dedicated publishing token (never the MCP token; equal tokens refuse to start). Prefer the *_FILE variant.
CONFLUENCE_REST_TOKEN=
CONFLUENCE_REST_TOKEN_FILE=
CONFLUENCE_REST_CA_BUNDLE=
CONFLUENCE_REST_TIMEOUT_SECONDS=15
CONFLUENCE_REST_ALLOW_INSECURE_HTTP=false
# The only space and parent page that may receive pages (never taken from requests or documents).
CONFLUENCE_TARGET_SPACE=
CONFLUENCE_PARENT_PAGE_ID=
# Document statuses that may be published (comma-separated subset of approved, in_review, draft).
CONFLUENCE_PUBLISH_STATUSES=approved
# live_write_staging only: must repeat CONFLUENCE_TARGET_SPACE to acknowledge real writes. Keep empty.
CONFLUENCE_PUBLISH_STAGING_ACK=

# GitLab write operations require an explicit enabled flag, KNOWLEDGE_BACKEND=gitlab AND human review.
GITLAB_PROPOSALS_ENABLED=false
# Public UI address used only for the proposal link inside an MR description (loopback in local_demo).
APP_PUBLIC_URL=

# Never set AUTH_MODE=local_demo in multiuser/server deployment.
