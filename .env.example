# Default: entirely offline local demo; do not place live credentials here.
# For the TEST integration environment use deploy/integration/integration.env.example instead.
# Copy to .env only if you need to change something; every value below is the safe default.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173
AUTH_MODE=local_demo
# Host headers accepted by the API. local_demo accepts loopback names only (fails closed otherwise).
ALLOWED_HOSTS=localhost,127.0.0.1,::1
LOG_LEVEL=INFO

# Content — a separate GitLab repository when available.
KNOWLEDGE_BACKEND=local
LOCAL_KNOWLEDGE_DIR=./workspace/knowledge
FIXTURES_DIR=./fixtures/knowledge
SEED_FIXTURES=true
LOCAL_CONTENT_IS_DEMO=true
REVIEW_STALE_DAYS=180
GITLAB_URL=
GITLAB_PROJECT_ID=
GITLAB_DEFAULT_BRANCH=main
# Optional sub-directory with knowledge documents inside the GitLab repository.
GITLAB_KNOWLEDGE_PATH=
GITLAB_TIMEOUT_SECONDS=15
GITLAB_REFRESH_SECONDS=60
# Configure via approved secret storage / environment injection, never commit secrets:
GITLAB_TOKEN=
# Preferred: path to a file with the token (Docker/K8s secret, vault agent); mutually exclusive with GITLAB_TOKEN.
GITLAB_TOKEN_FILE=
# PEM bundle of the corporate CA (empty = system trust store).
GITLAB_CA_BUNDLE=

# Search and derived local state (rebuildable; never authoritative knowledge).
SEARCH_BACKEND=sqlite_fts
SEARCH_INDEX_PATH=./workspace/search.sqlite3
APP_STATE_PATH=./workspace/app_state.sqlite3

# AI — safe no-network default. Never implicitly use public endpoints.
# AI_PROVIDER: mock | internal_api | disabled
AI_PROVIDER=mock
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_API_KEY_FILE=
AI_CA_BUNDLE=
# Comma-separated hostnames the backend may call for AI (must contain the AI_BASE_URL host).
AI_ALLOWED_HOSTS=
AI_TIMEOUT_SECONDS=30

# Confluence Data Center via approved read-only MCP (disabled by default).
# CONFLUENCE_CONNECTOR: disabled | mock (synthetic pages, for demos/tests) | mcp
CONFLUENCE_CONNECTOR=disabled
CONFLUENCE_MCP_URL=
CONFLUENCE_MCP_AUTH_TOKEN=
CONFLUENCE_MCP_AUTH_TOKEN_FILE=
CONFLUENCE_MCP_CA_BUNDLE=
CONFLUENCE_ALLOWLISTED_SPACES=
# JSON mapping of capabilities to tools discovered on the approved MCP server (tool names are never guessed):
# {"search":{"tool":"<name>","query_arg":"query","limit_arg":"limit","spaces_arg":"spaces"},"read":{"tool":"<name>","id_arg":"page_id"}}
CONFLUENCE_MCP_TOOL_MAP=
# Hosts allowed in links returned by Confluence (anything else is shown as a non-clickable reference).
CONFLUENCE_LINK_HOSTS=
# Base for relative links such as _links.webui (host must be in CONFLUENCE_LINK_HOSTS).
CONFLUENCE_WEB_BASE_URL=
# Optional JSON: where page fields are in tool results, e.g. {"items":"results","id":"content.id"}
CONFLUENCE_MCP_RESULT_MAP=

# Publication is explicitly disabled until later approval (milestone M5).
CONFLUENCE_PUBLISH_ENABLED=false
CONFLUENCE_REST_URL=
CONFLUENCE_TARGET_SPACE=

# GitLab write operations require an explicit enabled flag, KNOWLEDGE_BACKEND=gitlab AND human review.
GITLAB_PROPOSALS_ENABLED=false

# Never set AUTH_MODE=local_demo in multiuser/server deployment.
